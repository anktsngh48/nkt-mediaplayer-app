<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#1400E5FF" /><stroke android:width="1dp" android:color="#5900E5FF" /></shape></item>
    <item android:state_activated="true"><shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#1F00E5FF" /><stroke android:width="1dp" android:color="@color/accent" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="@color/card" /><stroke android:width="1dp" android:color="@color/success" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="@color/card" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
</selector>
