<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NKTTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="NKTSegment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/muted</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">9.5sp</item>
    </style>

    <style name="NKTViewSeg">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">6dp</item>
        <item name="android:tint">@color/muted</item>
    </style>

    <style name="NKTChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="NKTSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="NKTOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/text</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="NKTBarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/accent</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="NKTCtrl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">#FFFFFFFF</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="NKTLyrTool">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/muted</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="NKTLyrStep">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_tile_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
