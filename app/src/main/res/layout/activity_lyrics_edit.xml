<?xml version="1.0" encoding="utf-8"?>
<!-- Lyrics editor: TEXT (type or paste) and TIMING (stamp each line while the song plays) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/le_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:tint="@color/accent" />

        <TextView
            android:id="@+id/le_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:text="@string/lyr_edit_title"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/le_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_start_btn"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/lyr_save"
            android:textColor="@color/bg"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/le_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/le_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/le_tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_segment_box"
        android:orientation="horizontal"
        android:padding="4dp" />

    <!-- TEXT -->
    <LinearLayout
        android:id="@+id/le_page_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/le_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:background="@drawable/bg_editor"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/lyr_edit_help"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/le_undo" style="@style/NKTLyrTool" android:drawableStart="@drawable/ic_undo" android:text="@string/lyr_undo" />
            <TextView android:id="@+id/le_redo" style="@style/NKTLyrTool" android:drawableStart="@drawable/ic_redo" android:text="@string/lyr_redo" />
            <TextView android:id="@+id/le_paste" style="@style/NKTLyrTool" android:drawableStart="@drawable/ic_paste" android:text="@string/lyr_paste" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/le_online" style="@style/NKTLyrTool" android:drawableStart="@drawable/ic_search" android:text="@string/lyr_online" />
        </LinearLayout>
    </LinearLayout>

    <!-- TIMING -->
    <LinearLayout
        android:id="@+id/le_page_timing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/le_lines"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/le_lines_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="28dp"
                android:text="@string/lyr_timing_empty"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_options_bar"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/le_cur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00.0"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/le_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#4000E5FF"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/le_dur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/le_back5" style="@style/NKTLyrStep" android:text="@string/lyr_back5" />

                <ImageButton
                    android:id="@+id/le_play"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_play_btn"
                    android:contentDescription="@string/cd_play"
                    android:scaleType="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/accent" />

                <TextView android:id="@+id/le_fwd5" style="@style/NKTLyrStep" android:text="@string/lyr_fwd5" />
            </LinearLayout>

            <TextView
                android:id="@+id/le_stamp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_start_btn"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="8dp"
                android:drawableTint="@color/bg"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/lyr_stamp"
                android:textColor="@color/bg"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="@string/lyr_fine"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView android:id="@+id/le_earlier" style="@style/NKTLyrStep" android:layout_width="56dp" android:layout_height="44dp" android:text="@string/lyr_earlier" />
                <TextView android:id="@+id/le_later" style="@style/NKTLyrStep" android:layout_width="56dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="@string/lyr_later" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
