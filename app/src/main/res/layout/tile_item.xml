<?xml version="1.0" encoding="utf-8"?>
<!-- GRID view tile for songs, files, folders and playlists (same ids as row_item) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_segment"
    android:orientation="vertical"
    android:padding="4dp">

    <com.nkt.mediaplayer.SquareFrame
        android:id="@+id/tile_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cell">

        <ImageView
            android:id="@+id/row_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@null"
            android:padding="0dp"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/row_badge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_folder"
            android:tint="@color/accent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/row_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_circle"
            android:tint="@color/accent"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/row_more"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more"
            android:tint="@color/text" />
    </com.nkt.mediaplayer.SquareFrame>

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/row_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <Switch
        android:id="@+id/row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
