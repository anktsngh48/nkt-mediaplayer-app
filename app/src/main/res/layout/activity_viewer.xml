<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vw_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ‹ › previous / next photo or video -->
    <ImageButton
        android:id="@+id/vw_prev"
        android:layout_width="44dp"
        android:layout_height="64dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_side_btn"
        android:contentDescription="@string/cd_prev_item"
        android:src="@drawable/ic_chevron_left"
        android:tint="@color/text" />

    <ImageButton
        android:id="@+id/vw_next"
        android:layout_width="44dp"
        android:layout_height="64dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_side_btn"
        android:contentDescription="@string/cd_next_item"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text" />

    <LinearLayout
        android:id="@+id/vw_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_viewer_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="30dp">

        <ImageButton
            android:id="@+id/vw_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/vw_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/vw_full"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_full_player"
            android:src="@drawable/ic_fullscreen"
            android:tint="@color/text"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/vw_fav"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/favourite"
            android:src="@drawable/ic_heart"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/vw_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/vw_info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/properties"
            android:src="@drawable/ic_info"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/vw_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete"
            android:tint="@color/text" />

        <!-- ⋮ : rename · copy · cut · set as wallpaper -->
        <ImageButton
            android:id="@+id/vw_more"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more"
            android:tint="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vw_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_viewer_bottom"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="22dp">

        <!-- Videos: time · seek bar · length -->
        <LinearLayout
            android:id="@+id/vw_seek_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vw_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/vw_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/vw_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="40dp"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vw_film"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/vw_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/viewer_hint"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
