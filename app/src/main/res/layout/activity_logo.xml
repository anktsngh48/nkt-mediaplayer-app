<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/lg_back"
            style="@style/NKTBarButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/lg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="@string/app_logo_caps"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lg_default_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp">

                    <ImageView
                        android:id="@+id/lg_default_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/art_logo" />

                    <ImageView
                        android:id="@+id/lg_default_tick"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|end"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lg_default_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.14"
                    android:text="@string/logo_default_caps"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lg_yours_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp">

                    <ImageView
                        android:id="@+id/lg_yours_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_image"
                        android:tint="@color/muted" />

                    <ImageView
                        android:id="@+id/lg_yours_tick"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|end"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/accent"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lg_yours_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.14"
                    android:text="@string/logo_yours_caps"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/lg_choose"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pill_btn"
            android:gravity="center"
            android:text="@string/logo_choose"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lg_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/logo_use_default"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/logo_hint"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
