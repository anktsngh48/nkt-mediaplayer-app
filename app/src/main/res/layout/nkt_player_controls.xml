<?xml version="1.0" encoding="utf-8"?>
<!-- Video controls: a small back + title row on top, everything else at the bottom. Hidden until you tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="22dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="30dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ctl_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/ctl_seek"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/accent"
                android:secondaryProgressTint="#88FFFFFF"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/ctl_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btn_rotate" style="@style/NKTCtrl" android:contentDescription="@string/cd_rotate" android:src="@drawable/ic_screen_rotation" />

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_speed"
                android:gravity="center"
                android:maxLines="1"
                android:text="1×"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton android:id="@+id/ctl_prev" style="@style/NKTCtrl" android:contentDescription="@string/cd_prev" android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/ctl_play"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.3"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_play"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/accent" />

            <ImageButton android:id="@+id/ctl_next" style="@style/NKTCtrl" android:contentDescription="@string/cd_next" android:src="@drawable/ic_next" />
            <ImageButton android:id="@+id/btn_fav" style="@style/NKTCtrl" android:contentDescription="@string/favourite" android:src="@drawable/ic_heart" />
            <ImageButton android:id="@+id/btn_pip" style="@style/NKTCtrl" android:contentDescription="@string/pip" android:src="@drawable/ic_pip" />
            <ImageButton android:id="@+id/btn_more" style="@style/NKTCtrl" android:contentDescription="@string/cd_more" android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <!-- ‹ › previous / next video, on the sides while the controls show -->
    <ImageButton
        android:id="@+id/vid_prev"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_side_btn"
        android:contentDescription="@string/cd_prev_video"
        android:src="@drawable/ic_chevron_left"
        android:tint="@color/text" />

    <ImageButton
        android:id="@+id/vid_next"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_side_btn"
        android:contentDescription="@string/cd_next_video"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text" />
</FrameLayout>
