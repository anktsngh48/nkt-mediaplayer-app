<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <include layout="@layout/nkt_player_controls" />

    <!-- Picture of the moment you're seeking to -->
    <LinearLayout
        android:id="@+id/seek_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="118dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seek_img"
            android:layout_width="176dp"
            android:layout_height="99dp"
            android:background="@drawable/bg_preview"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Press and hold: plays at 2× while the finger stays down -->
    <TextView
        android:id="@+id/hold_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_indicator"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/hold_2x"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Gesture feedback: "Volume 60%", "+0:15 · 1:23", … -->
    <TextView
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_indicator"
        android:letterSpacing="0.08"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
