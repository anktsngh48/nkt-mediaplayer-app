<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- List area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <!-- Online Music: the page is added here the first time it opens -->
        <FrameLayout
            android:id="@+id/online_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Everything above the files: slides away when you scroll down, comes back when you scroll up -->
        <LinearLayout
            android:id="@+id/collapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:clickable="true"
            android:elevation="4dp"
            android:orientation="vertical">

            <!-- ☰ · NKT MEDIA PLAYER / page · PC · link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/NKTBarButton"
                    android:contentDescription="@string/cd_menu"
                    android:src="@drawable/ic_menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="@string/header"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/page_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.16"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- One round play / pause button: the mini player, always at hand (long-press opens Now Playing) -->
                <ImageButton
                    android:id="@+id/btn_mini"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round_btn"
                    android:contentDescription="@string/cd_play"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/accent"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_link"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_round_btn"
                    android:contentDescription="@string/cd_link"
                    android:src="@drawable/ic_link"
                    android:tint="@color/accent" />
            </LinearLayout>

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/muted"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <!-- Folders page: storage switch, path, hidden note -->
            <LinearLayout
                android:id="@+id/folder_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/storage_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/folder_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:textColor="@color/accent"
                    android:textSize="12.5sp" />

                <!-- UP · NEW · PASTE: actions, styled apart from the files below -->
                <LinearLayout
                    android:id="@+id/folder_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/folder_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- count · updating · sort · view -->
            <LinearLayout
                android:id="@+id/tab_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tab_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/updating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:text="@string/updating"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_segment_box"
                    android:contentDescription="@string/sort"
                    android:drawableStart="@drawable/ic_sort"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/accent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/view_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_box"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <ImageButton android:id="@+id/view_a" style="@style/NKTViewSeg" android:contentDescription="@string/view_list" android:src="@drawable/ic_list" />
                    <ImageButton android:id="@+id/view_b" style="@style/NKTViewSeg" android:contentDescription="@string/view_grid" android:src="@drawable/ic_grid" />
                    <ImageButton android:id="@+id/view_c" style="@style/NKTViewSeg" android:contentDescription="@string/view_squares" android:src="@drawable/ic_music" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gallery: albums + filter -->
            <LinearLayout
                android:id="@+id/gallery_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/albums"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <TextView android:id="@+id/seg_all" style="@style/NKTSegment" android:text="@string/seg_all" />
                    <TextView android:id="@+id/seg_photos" style="@style/NKTSegment" android:text="@string/seg_photos" />
                    <TextView android:id="@+id/seg_videos" style="@style/NKTSegment" android:text="@string/seg_videos" />

                    <TextView
                        android:id="@+id/grid_size"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Shown while picking several items -->
        <LinearLayout
            android:id="@+id/select_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_options_bar"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton android:id="@+id/sel_close" style="@style/NKTBarButton" android:contentDescription="@string/cancel" android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/sel_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton android:id="@+id/sel_all" style="@style/NKTBarButton" android:contentDescription="@string/select_all" android:src="@drawable/ic_select_all" />
            <ImageButton android:id="@+id/sel_info" style="@style/NKTBarButton" android:contentDescription="@string/cd_sel_info" android:src="@drawable/ic_info" />
            <ImageButton android:id="@+id/sel_share" style="@style/NKTBarButton" android:contentDescription="@string/share" android:src="@drawable/ic_share" />
            <ImageButton android:id="@+id/sel_delete" style="@style/NKTBarButton" android:contentDescription="@string/delete" android:src="@drawable/ic_delete" />
            <!-- ⋮ : add to playlist · copy · cut -->
            <ImageButton android:id="@+id/sel_more" style="@style/NKTBarButton" android:contentDescription="@string/cd_more" android:src="@drawable/ic_more" />
        </LinearLayout>

        <!-- Side bar: drag to jump through long lists -->
        <com.nkt.mediaplayer.FastScroller
            android:id="@+id/fast_scroller"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

        <TextView
            android:id="@+id/fs_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_indicator"
            android:maxLines="1"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- "5 per row" while pinching the gallery -->
        <TextView
            android:id="@+id/zoom_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="140dp"
            android:background="@drawable/bg_indicator"
            android:letterSpacing="0.08"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/perm_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/perm_text"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/perm_btn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_btn"
                android:letterSpacing="0.15"
                android:minWidth="200dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:stateListAnimator="@null"
                android:text="@string/perm_button"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mini player -->
    <LinearLayout
        android:id="@+id/mini"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_mini"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mini_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mini_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/cd_play"
            android:src="@drawable/ic_play"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/mini_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_next"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/mini_close"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_close_player"
            android:src="@drawable/ic_close"
            android:tint="@color/muted" />
    </LinearLayout>

</LinearLayout>

    <!-- ☰ menu -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#B3000000"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:elevation="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawer_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp" />
    </ScrollView>
</FrameLayout>
