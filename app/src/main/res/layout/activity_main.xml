<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/header"
            android:textColor="@color/accent"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/btn_share_pc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/nkt_share"
            android:src="@drawable/ic_pc"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btn_link"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/cd_link"
            android:src="@drawable/ic_link"
            android:tint="@color/accent" />
    </LinearLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/muted"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <!-- Tabs (scroll sideways) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView android:id="@+id/tab_songs" style="@style/NKTTab" android:text="@string/tab_songs" />
            <TextView android:id="@+id/tab_videos" style="@style/NKTTab" android:text="@string/tab_videos" />
            <TextView android:id="@+id/tab_gallery" style="@style/NKTTab" android:text="@string/tab_gallery" />
            <TextView android:id="@+id/tab_folders" style="@style/NKTTab" android:text="@string/tab_folders" />
            <TextView android:id="@+id/tab_playlists" style="@style/NKTTab" android:text="@string/tab_playlists" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Songs: LIST / SQUARES switch -->
    <LinearLayout
        android:id="@+id/songs_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/songs_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_box"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView android:id="@+id/view_list" style="@style/NKTSegment" android:drawableStart="@drawable/ic_list" android:text="@string/view_list" />
            <TextView android:id="@+id/view_squares" style="@style/NKTSegment" android:drawableStart="@drawable/ic_grid" android:text="@string/view_squares" />
        </LinearLayout>
    </LinearLayout>

    <!-- Gallery: albums + filter -->
    <LinearLayout
        android:id="@+id/gallery_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/albums"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <TextView android:id="@+id/seg_all" style="@style/NKTSegment" android:text="@string/seg_all" />
            <TextView android:id="@+id/seg_photos" style="@style/NKTSegment" android:text="@string/seg_photos" />
            <TextView android:id="@+id/seg_videos" style="@style/NKTSegment" android:text="@string/seg_videos" />

            <TextView
                android:id="@+id/grid_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- List area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- "5 per row" while pinching the gallery -->
        <TextView
            android:id="@+id/zoom_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_indicator"
            android:letterSpacing="0.08"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/perm_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/perm_text"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/perm_btn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_btn"
                android:letterSpacing="0.15"
                android:minWidth="200dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:stateListAnimator="@null"
                android:text="@string/perm_button"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mini player -->
    <LinearLayout
        android:id="@+id/mini"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_mini"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mini_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mini_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/cd_play"
            android:src="@drawable/ic_play"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/mini_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_next"
            android:tint="@color/accent" />
    </LinearLayout>
</LinearLayout>
