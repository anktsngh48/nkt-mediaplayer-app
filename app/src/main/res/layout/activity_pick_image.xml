<?xml version="1.0" encoding="utf-8"?>
<!-- NKT's own picture chooser: back button, title, a button for other apps, then a grid of the phone's pictures -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/pi_back"
            style="@style/NKTBarButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/pi_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="@string/pick_image_title"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pi_other"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_viz_chip"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/pick_other_apps"
            android:textColor="@color/accent"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pi_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/pick_image_empty"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pi_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp" />
</LinearLayout>
