<?xml version="1.0" encoding="utf-8"?>
<com.nkt.mediaplayer.SquareFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1.5dp">

    <ImageView
        android:id="@+id/gc_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cell"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/gc_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="5dp"
        android:background="@drawable/bg_badge"
        android:drawableStart="@drawable/ic_play"
        android:drawablePadding="2dp"
        android:drawableTint="#FFFFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="3dp"
        android:paddingEnd="7dp"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <View
        android:id="@+id/gc_hidden"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_hidden_dot"
        android:visibility="gone" />
    <View
        android:id="@+id/gc_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5900E5FF"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/gc_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_circle"
        android:tint="#FFFFFFFF"
        android:visibility="gone" />
</com.nkt.mediaplayer.SquareFrame>
