<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/np_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/np_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.22"
                android:text="@string/now_playing"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/np_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="@string/cd_more"
                android:src="@drawable/ic_more"
                android:tint="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/np_sleep"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_running"
            android:drawableStart="@drawable/ic_timer"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Album art, or the lyrics in its place -->
        <FrameLayout
            android:id="@+id/np_stage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="14dp">

            <com.nkt.mediaplayer.VizView
                android:id="@+id/np_viz"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_viz"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/np_viz_ovl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ovl_beat"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_viz_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/ovl_beat_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.18"
                        android:text="@string/viz_beat"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:id="@+id/ovl_beat_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ovl_bpm"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_viz_chip"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/ovl_sa"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_viz_chip"
                    android:drawableStart="@drawable/ic_tune"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/accent"
                    android:textSize="9.5sp" />

                <LinearLayout
                    android:id="@+id/ovl_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_viz_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/ovl_speed_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="@string/viz_speed"
                        android:textColor="@color/accent"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/ovl_sp0"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="20"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ovl_sp1"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="40"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ovl_sp2"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="60"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ovl_sp3"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="80"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/ovl_style"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_viz_chip"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/accent"
                    android:textSize="9.5sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/np_art"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_art"
                android:contentDescription="@null"
                android:elevation="12dp"
                android:outlineSpotShadowColor="@color/accent" />

            <TextView
                android:id="@+id/np_find_art"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="62dp"
                android:background="@drawable/bg_pill_btn"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="8dp"
                android:drawableTint="@color/accent"
                android:elevation="14dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                android:text="@string/find_art"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/np_lyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_options_bar"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/lyr_sync"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <ImageButton android:id="@+id/lyr_minus" style="@style/NKTBarButton" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@string/lyr_later" android:src="@drawable/ic_minus" />
                    <ImageButton android:id="@+id/lyr_plus" style="@style/NKTBarButton" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@string/lyr_sooner" android:src="@drawable/ic_plus" />
                    <ImageButton android:id="@+id/lyr_search" style="@style/NKTBarButton" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@string/lyr_search_again" android:src="@drawable/ic_search" />
                    <TextView
                        android:id="@+id/lyr_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_viz_edit"
                        android:drawableStart="@drawable/ic_edit"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/accent"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/lyr_edit"
                        android:textColor="@color/accent"
                        android:textSize="9sp" />
                    <ImageButton android:id="@+id/lyr_close" style="@style/NKTBarButton" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@string/cancel" android:src="@drawable/ic_close" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lyr_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="16dp"
                        android:paddingTop="90dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="120dp" />

                    <TextView
                        android:id="@+id/lyr_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="20dp"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Which view the stage shows: Visualiser, Lyrics, Thumbnail (tap a dot) -->
        <LinearLayout
            android:id="@+id/np_dots"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Seek bar -->
        <SeekBar
            android:id="@+id/np_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:progressBackgroundTint="#4000E5FF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/np_cur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/np_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/np_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_shuffle"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/np_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="@string/cd_prev"
                android:src="@drawable/ic_prev"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/np_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_play_btn"
                android:contentDescription="@string/cd_play"
                android:scaleType="center"
                android:src="@drawable/ic_play"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_next"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/np_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <!-- A video playing in the background: go back to watching it -->
        <TextView
            android:id="@+id/np_watch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_btn"
            android:drawableStart="@drawable/ic_movie"
            android:drawablePadding="8dp"
            android:drawableTint="@color/accent"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:text="@string/watch_video"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- MX-style options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_options_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView android:id="@+id/opt_eq" style="@style/NKTOption" android:drawableTop="@drawable/ic_eq" android:text="@string/opt_eq" />
            <TextView android:id="@+id/opt_timer" style="@style/NKTOption" android:drawableTop="@drawable/ic_timer" android:text="@string/opt_timer" />
            <TextView android:id="@+id/opt_speed" style="@style/NKTOption" android:drawableTop="@drawable/ic_speed" android:text="@string/opt_speed" />
            <TextView android:id="@+id/opt_lyrics" style="@style/NKTOption" android:drawableTop="@drawable/ic_lyrics" android:text="@string/opt_lyrics" />
            <TextView android:id="@+id/opt_karaoke" style="@style/NKTOption" android:drawableTop="@drawable/ic_mic_off" android:text="@string/opt_karaoke" />
            <TextView android:id="@+id/opt_queue" style="@style/NKTOption" android:drawableTop="@drawable/ic_playlist" android:text="@string/opt_queue" />
            <TextView android:id="@+id/opt_fav" style="@style/NKTOption" android:drawableTop="@drawable/ic_heart" android:text="@string/opt_fav" />
        </LinearLayout>

        <!-- Up next -->
        <LinearLayout
            android:id="@+id/np_upnext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_upnext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/np_upnext_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/up_next"
                android:textColor="@color/accent"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/np_upnext_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_playlist"
                android:tint="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
