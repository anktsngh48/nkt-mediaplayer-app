<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget 4×3: the picture (album art or lyrics) edge to edge, the song in one row, previous / play-pause / next in the next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="1dp">

    <ImageView
        android:id="@+id/w_scene"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/w_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFE8F0FE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF8A9AB2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_small_btn"
            android:contentDescription="@string/cd_prev"
            android:src="@drawable/wg_prev" />

        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_widget_play"
            android:contentDescription="@string/cd_play"
            android:src="@drawable/wg_pause" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_small_btn"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/wg_next" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
