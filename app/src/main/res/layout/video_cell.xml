<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <com.nkt.mediaplayer.WideFrame
        android:id="@+id/vc_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cell">

        <ImageView
            android:id="@+id/vc_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/vc_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp" />

        <View
            android:id="@+id/vc_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#5900E5FF"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/vc_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_circle"
            android:tint="#FFFFFFFF"
            android:visibility="gone" />
    </com.nkt.mediaplayer.WideFrame>

    <TextView
        android:id="@+id/vc_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/vc_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
